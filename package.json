{
  "name": "pd-revision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply pd --local",
    "migrate:remote": "wrangler d1 migrations apply pd --remote",
    "migrate:list": "wrangler d1 migrations list pd --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@sveltejs/adapter-cloudflare": "^5.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "sass": "^1.80.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "~4.101.0"
  }
}
